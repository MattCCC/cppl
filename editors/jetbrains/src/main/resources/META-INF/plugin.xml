<idea-plugin>
    <id>dev.cppl.jetbrains</id>
    <name>C++L</name>
    <vendor>C++L</vendor>

    <description><![CDATA[
        C++L language support for JetBrains IDEs: diagnostics, navigation,
        canonical formatting and syntax highlighting, provided by the
        <code>cppl-lsp</code> language server.
        <br/><br/>
        Requires <code>cppl-lsp</code> on PATH or built at
        <code>build/dev/bin/cppl-lsp</code> in the project.
    ]]></description>

    <!-- The platform LSP API lives in the commercial IDE platform. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <!-- Coloring is the shared TextMate grammar, through the bundled TextMate support. -->
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider
            implementation="dev.cppl.CpplTextMateBundleProvider"/>

        <platform.lsp.serverSupportProvider
            implementation="dev.cppl.CpplLspSupportProvider"/>
    </extensions>
</idea-plugin>
