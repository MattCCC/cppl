    },

    {
      "name": "ci-macos-llvm",
      "displayName": "CI / macOS LLVM workflow",
      "steps": [
        {
          "type": "configure",
          "name": "ci-macos-llvm"
        },
        {
          "type": "build",
          "name": "ci-macos-llvm"
        },
        {
          "type": "test",
          "name": "ci-macos-llvm"
        }
      ]
    },

    {
      "name": "ci-windows-clang-cl",
      "displayName": "CI / Windows Clang-CL workflow",
      "steps": [
        {
          "type": "configure",
          "name": "ci-windows-clang-cl"
        },
        {
          "type": "build",
          "name": "ci-windows-clang-cl"
        },
        {
          "type": "test",
          "name": "ci-windows-clang-cl"
        }
      ]
    }
  ]
}
